
enum UserStatus {
  ACTIVE
  BANNED
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}
model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String
  phone        String
  role         Role
  status       UserStatus @default(ACTIVE)
  profileImage String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  properties     Property[]
  rentalRequests RentalRequest[]
  payments       Payment[]
  reviews        Review[]

  @@map("users") 
}